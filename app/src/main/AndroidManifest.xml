<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application
        android:name=".ZisApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:localeConfig="@xml/locales_config"
        android:theme="@style/Theme.Scopa">

        <!-- screenOrientation resta per i telefoni. Da Android 16 (targetSdk 36) i
             dispositivi con lato corto da 600dp in su lo ignorano: le schermate di gioco
             gestiscono da sole il ridimensionamento con configChanges, cosi' ruotando un
             tablet la partita in corso non viene persa.

             L'elenco di configChanges e' piu' lungo della sola rotazione perche' l'activity
             non deve essere ricreata nemmeno quando l'utente, a partita in corso, cambia
             tema scuro/chiaro (uiMode), dimensione del carattere (fontScale), lingua
             (locale), verso di scrittura (layoutDirection) o quando cambia la densita'
             (density: succede aprendo e chiudendo un pieghevole). Prima ognuno di questi
             faceva ripartire la mano da zero. Il prezzo e' che le scritte gia' a schermo
             non si riscalano subito cambiando la dimensione del carattere: si aggiornano
             tornando al menu. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="portrait">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".GameActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|density|fontScale|uiMode" />
        <activity
            android:name=".SettingsActivity"
            android:exported="false"
            android:screenOrientation="portrait" />
        <activity
            android:name=".BriscolaActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|density|fontScale|uiMode" />

        <activity
            android:name=".TresetteActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|density|fontScale|uiMode" />

        <activity
            android:name=".PokerActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|density|fontScale|uiMode" />

        <!--
          Il solitario dichiara gli stessi configChanges degli altri tre, ma qui contano di
          piu': il tavolo si ridisegna a partire dalla larghezza del contenitore, e lasciare
          che Android ricrei l'activity a ogni cambio di tema o di dimensione del carattere
          vorrebbe dire ridistribuire le carte.
        -->
        <activity
            android:name=".KlondikeActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|density|fontScale|uiMode" />

        <!--
          IL SERVIZIO CHE NON FA NIENTE, e serve.

          setApplicationLocales fa persistere la scelta della lingua da sola solo da
          Android 13 in su, dove ci pensa il sistema. Sotto, ci pensa appcompat, ma a
          patto di trovare questo servizio dichiarato con autoStoreLocales a true: e'
          il posto dove va a scriversi la preferenza. Senza, su Android da 7 a 12 la
          lingua tornerebbe italiana a ogni riavvio dell'app - cioe' su tutti i telefoni
          piu' vecchi del minSdk in su, che sono proprio quelli per cui esiste appcompat.

          android:enabled="false" e' corretto e non un errore: il servizio non viene mai
          avviato, appcompat lo usa solo come contenitore per il meta-data.
        -->
        <service
            android:name="androidx.appcompat.app.AppLocalesMetadataHolderService"
            android:enabled="false"
            android:exported="false">
            <meta-data
                android:name="autoStoreLocales"
                android:value="true" />
        </service>

    </application>
</manifest>
