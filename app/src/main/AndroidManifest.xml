<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application
        android:name=".ZisApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.Scopa">

        <!-- screenOrientation resta per i telefoni. Da Android 16 (targetSdk 36) i
             dispositivi con lato corto da 600dp in su lo ignorano: le schermate di gioco
             gestiscono da sole il ridimensionamento con configChanges, cosi' ruotando un
             tablet la partita in corso non viene persa.

             L'elenco di configChanges e' piu' lungo della sola rotazione perche' l'activity
             non deve essere ricreata nemmeno quando l'utente, a partita in corso, cambia
             tema scuro/chiaro (uiMode), dimensione del carattere (fontScale), lingua
             (locale), verso di scrittura (layoutDirection) o quando cambia la densita'
             (density: succede aprendo e chiudendo un pieghevole). Prima ognuno di questi
             faceva ripartire la mano da zero. Il prezzo e' che le scritte gia' a schermo
             non si riscalano subito cambiando la dimensione del carattere: si aggiornano
             tornando al menu. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="portrait">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".GameActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|density|fontScale|uiMode|locale|layoutDirection" />
        <activity
            android:name=".SettingsActivity"
            android:exported="false"
            android:screenOrientation="portrait" />
        <activity
            android:name=".BriscolaActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|density|fontScale|uiMode|locale|layoutDirection" />

        <activity
            android:name=".TresetteActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|density|fontScale|uiMode|locale|layoutDirection" />
    </application>
</manifest>
