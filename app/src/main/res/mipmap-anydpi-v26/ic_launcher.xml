<?xml version="1.0" encoding="utf-8"?>
<!-- Icona adattiva (Android 8+). Il foreground e' rientrato di 18dp sui 108dp
     totali, cosi' il logo resta dentro la "safe zone" di 72dp e non viene
     tagliato dalle maschere circolari / squircle dei vari launcher. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/navy_deep" />
    <foreground>
        <inset
            android:drawable="@drawable/app_logo"
            android:inset="18dp" />
    </foreground>
</adaptive-icon>
