<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_velvet">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:padding="24dp"
        android:clipToPadding="false"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/btnBack">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/settings_title"
                android:textColor="@color/silver"
                android:textSize="26sp"
                android:textStyle="bold"
                android:shadowColor="#000000" android:shadowDy="3" android:shadowRadius="6" />

            <!-- Mazzo -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:background="@drawable/panel_bg"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/deck_section"
                    android:textColor="@color/silver"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="@string/deck_label"
                    android:textColor="@color/silver"
                    android:textSize="16sp" />

                <RadioGroup
                    android:id="@+id/groupDeck"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="vertical">

                    <RadioButton
                        android:id="@+id/radioDeckZis"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        android:buttonTint="@color/celeste"
                        android:text="@string/deck_zis"
                        android:textColor="@color/silver"
                        android:textSize="17sp" />

                    <RadioButton
                        android:id="@+id/radioDeckTrad"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:buttonTint="@color/celeste"
                        android:text="@string/deck_trad"
                        android:textColor="@color/silver"
                        android:textSize="17sp" />
                </RadioGroup>

                <TextView
                    android:id="@+id/txtDeckInfo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/deck_missing"
                    android:textColor="@color/silver_dark"
                    android:textSize="13sp"
                    android:visibility="gone" />
            </LinearLayout>

            <!-- Scopa -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:background="@drawable/panel_bg"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/play"
                    android:textColor="@color/silver"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="@string/score_target_label"
                    android:textColor="@color/silver"
                    android:textSize="16sp" />

                <RadioGroup
                    android:id="@+id/groupTarget"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="vertical">

                    <RadioButton
                        android:id="@+id/radio11"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        android:buttonTint="@color/celeste"
                        android:text="@string/target_11"
                        android:textColor="@color/silver"
                        android:textSize="17sp" />

                    <RadioButton
                        android:id="@+id/radio21"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:buttonTint="@color/celeste"
                        android:text="@string/target_21"
                        android:textColor="@color/silver"
                        android:textSize="17sp" />
                </RadioGroup>
            </LinearLayout>

            <!-- Briscola -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:background="@drawable/panel_bg"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/play_briscola"
                    android:textColor="@color/silver"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="@string/briscola_hands_label"
                    android:textColor="@color/silver"
                    android:textSize="16sp" />

                <RadioGroup
                    android:id="@+id/groupBriscola"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="vertical">

                    <RadioButton
                        android:id="@+id/radioB5"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        android:buttonTint="@color/celeste"
                        android:text="@string/hands_5"
                        android:textColor="@color/silver"
                        android:textSize="17sp" />

                    <RadioButton
                        android:id="@+id/radioB11"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:buttonTint="@color/celeste"
                        android:text="@string/hands_11"
                        android:textColor="@color/silver"
                        android:textSize="17sp" />
                </RadioGroup>
            </LinearLayout>

            <!-- Tresette -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:background="@drawable/panel_bg"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/play_tresette"
                    android:textColor="@color/silver"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="@string/tresette_target_label"
                    android:textColor="@color/silver"
                    android:textSize="16sp" />

                <RadioGroup
                    android:id="@+id/groupTresette"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="vertical">

                    <RadioButton
                        android:id="@+id/radioT21"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        android:buttonTint="@color/celeste"
                        android:text="@string/tre_target_21"
                        android:textColor="@color/silver"
                        android:textSize="17sp" />

                    <RadioButton
                        android:id="@+id/radioT31"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:buttonTint="@color/celeste"
                        android:text="@string/tre_target_31"
                        android:textColor="@color/silver"
                        android:textSize="17sp" />
                </RadioGroup>
            </LinearLayout>

            <!-- Gioco responsabile -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:background="@drawable/panel_bg"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/pause_section"
                    android:textColor="@color/silver"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/switchPause"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/pause_switch"
                    android:textColor="@color/silver"
                    android:textSize="17sp"
                    app:thumbTint="@color/celeste"
                    app:trackTint="@color/steel" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/pause_switch_desc"
                    android:textColor="@color/silver_dark"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/txtPauseInfo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:textColor="@color/gold"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:visibility="gone" />
            </LinearLayout>

            <!-- Test -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:background="@drawable/panel_bg"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/test_section"
                    android:textColor="@color/silver"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/switchAuto"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/auto_play"
                    android:textColor="@color/silver"
                    android:textSize="17sp"
                    app:thumbTint="@color/celeste"
                    app:trackTint="@color/steel" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/auto_play_desc"
                    android:textColor="@color/silver_dark"
                    android:textSize="14sp" />

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/switchBotCards"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="@string/show_bot_cards"
                    android:textColor="@color/silver"
                    android:textSize="17sp"
                    app:thumbTint="@color/celeste"
                    app:trackTint="@color/steel" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/show_bot_cards_desc"
                    android:textColor="@color/silver_dark"
                    android:textSize="14sp" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btnBack"
        android:layout_width="220dp"
        android:layout_height="52dp"
        android:layout_marginBottom="24dp"
        android:background="@drawable/btn_cartiglio"
        android:text="@string/back_home"
        android:textColor="@color/silver"
        android:textSize="16sp"
        android:textStyle="bold"
        android:textAllCaps="false"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
