<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_velvet">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:padding="24dp"
        android:clipToPadding="false"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/btnBack">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/settings_title"
                android:textColor="@color/silver"
                android:textSize="26sp"
                android:textStyle="bold"
                android:shadowColor="#000000" android:shadowDy="3" android:shadowRadius="6" />

            <!--
              Il solitario sta per primo perche' e' l'unica impostazione che cambia le regole
              del gioco invece dell'aspetto o dei tempi.
            -->
            <LinearLayout
                android:id="@+id/panelKlondike"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:background="@drawable/panel_bg"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/kl_section"
                    android:textColor="@color/silver"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="@string/kl_draw_label"
                    android:textColor="@color/silver"
                    android:textSize="16sp" />

                <RadioGroup
                    android:id="@+id/groupDraw3"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:orientation="vertical">

                    <RadioButton
                        android:id="@+id/radioKl1"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        android:buttonTint="@color/celeste"
                        android:text="@string/kl_draw_1"
                        android:textColor="@color/silver"
                        android:textSize="17sp" />

                    <RadioButton
                        android:id="@+id/radioKl3"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:buttonTint="@color/celeste"
                        android:text="@string/kl_draw_3"
                        android:textColor="@color/silver"
                        android:textSize="17sp" />
                </RadioGroup>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/kl_draw_info"
                    android:textColor="@color/silver_dark"
                    android:textSize="13sp" />
            </LinearLayout>

            <!-- Mazzo -->
            <LinearLayout
                android:id="@+id/panelDeck"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:background="@drawable/panel_bg"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/deck_section"
                    android:textColor="@color/silver"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="@string/deck_label"
                    android:textColor="@color/silver"
                    android:textSize="16sp" />

                <RadioGroup
                    android:id="@+id/groupDeck"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="vertical">

                    <RadioButton
                        android:id="@+id/radioDeckZis"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        android:buttonTint="@color/celeste"
                        android:text="@string/deck_zis"
                        android:textColor="@color/silver"
                        android:textSize="17sp" />

                    <RadioButton
                        android:id="@+id/radioDeckTrad"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        android:buttonTint="@color/celeste"
                        android:text="@string/deck_trad"
                        android:textColor="@color/silver"
                        android:textSize="17sp" />

                    <RadioButton
                        android:id="@+id/radioDeckBerg"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        android:buttonTint="@color/celeste"
                        android:text="@string/deck_berg"
                        android:textColor="@color/silver"
                        android:textSize="17sp" />

                    <RadioButton
                        android:id="@+id/radioDeckNap"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:buttonTint="@color/celeste"
                        android:text="@string/deck_nap"
                        android:textColor="@color/silver"
                        android:textSize="17sp" />
                </RadioGroup>

            </LinearLayout>

            <!-- Scopa -->
            <LinearLayout
                android:id="@+id/panelScopa"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:background="@drawable/panel_bg"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/play_scopa"
                    android:textColor="@color/silver"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="@string/score_target_label"
                    android:textColor="@color/silver"
                    android:textSize="16sp" />

                <RadioGroup
                    android:id="@+id/groupTarget"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="vertical">

                    <RadioButton
                        android:id="@+id/radio11"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        android:buttonTint="@color/celeste"
                        android:text="@string/target_11"
                        android:textColor="@color/silver"
                        android:textSize="17sp" />

                    <RadioButton
                        android:id="@+id/radio21"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:buttonTint="@color/celeste"
                        android:text="@string/target_21"
                        android:textColor="@color/silver"
                        android:textSize="17sp" />
                </RadioGroup>
            </LinearLayout>

            <!-- Briscola -->
            <LinearLayout
                android:id="@+id/panelBriscola"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:background="@drawable/panel_bg"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/play_briscola"
                    android:textColor="@color/silver"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="@string/briscola_hands_label"
                    android:textColor="@color/silver"
                    android:textSize="16sp" />

                <RadioGroup
                    android:id="@+id/groupBriscola"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="vertical">

                    <RadioButton
                        android:id="@+id/radioB5"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        android:buttonTint="@color/celeste"
                        android:text="@string/hands_5"
                        android:textColor="@color/silver"
                        android:textSize="17sp" />

                    <RadioButton
                        android:id="@+id/radioB11"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:buttonTint="@color/celeste"
                        android:text="@string/hands_11"
                        android:textColor="@color/silver"
                        android:textSize="17sp" />
                </RadioGroup>
            </LinearLayout>

            <!-- Tresette -->
            <LinearLayout
                android:id="@+id/panelTresette"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:background="@drawable/panel_bg"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/play_tresette"
                    android:textColor="@color/silver"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="@string/tresette_target_label"
                    android:textColor="@color/silver"
                    android:textSize="16sp" />

                <RadioGroup
                    android:id="@+id/groupTresette"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="vertical">

                    <RadioButton
                        android:id="@+id/radioT21"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        android:buttonTint="@color/celeste"
                        android:text="@string/tre_target_21"
                        android:textColor="@color/silver"
                        android:textSize="17sp" />

                    <RadioButton
                        android:id="@+id/radioT31"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:buttonTint="@color/celeste"
                        android:text="@string/tre_target_31"
                        android:textColor="@color/silver"
                        android:textSize="17sp" />
                </RadioGroup>

                <!-- Quanto resta scoperta la carta pescata: e' una regola del Tresette e
                     sta con le altre del Tresette. Prima era in fondo alla schermata
                     generale, fra le probabilita' del poker e il gioco responsabile, dove
                     nessuno l'avrebbe cercata. -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="@string/draw_seconds_label"
                    android:textColor="@color/silver"
                    android:textSize="16sp" />

                <RadioGroup
                    android:id="@+id/groupDraw"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="vertical">

                    <RadioButton
                        android:id="@+id/radioDraw1"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        android:buttonTint="@color/celeste"
                        android:text="@string/draw_1s"
                        android:textColor="@color/silver"
                        android:textSize="17sp" />

                    <RadioButton
                        android:id="@+id/radioDraw2"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        android:buttonTint="@color/celeste"
                        android:text="@string/draw_2s"
                        android:textColor="@color/silver"
                        android:textSize="17sp" />

                    <RadioButton
                        android:id="@+id/radioDraw3"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:buttonTint="@color/celeste"
                        android:text="@string/draw_3s"
                        android:textColor="@color/silver"
                        android:textSize="17sp" />
                </RadioGroup>
            </LinearLayout>

            <!-- Poker -->
            <LinearLayout
                android:id="@+id/panelPoker"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:background="@drawable/panel_bg"
                android:orientation="vertical"
                android:padding="18dp">

                <!-- ============================= Poker ============================= -->

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="22dp"
                    android:text="@string/poker_section"
                    android:textColor="@color/celeste"
                    android:textSize="19sp"
                    android:textStyle="bold" />

                <!-- La scelta della variante stava qui, ed era un interruttore per una cosa
                     che adesso e' un gioco a se': nel menu ci sono due bottoni, [Poker] e
                     [Hold'em], e questo pannello vale per tutti due - stessi giocatori,
                     stessi importi, stesso mazzo corto. Le statistiche invece sono separate,
                     perche' due giochi diversi non fanno una percentuale sola. -->

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="@string/poker_players"
                    android:textColor="@color/silver"
                    android:textSize="16sp" />

                <!-- Due scelte, due numeri, una riga: "2" e "4" dicono tutto quello che
                     c'e' da dire, e in verticale si portavano via il doppio dello spazio per
                     scrivere due volte la parola "giocatori" che sta gia' nel titolo sopra. -->
                <RadioGroup
                    android:id="@+id/groupGiocatori"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal">

                    <RadioButton
                        android:id="@+id/radioG2"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="28dp"
                        android:buttonTint="@color/celeste"
                        android:text="@string/poker_players_2"
                        android:textColor="@color/silver"
                        android:textSize="17sp" />

                    <RadioButton
                        android:id="@+id/radioG4"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:buttonTint="@color/celeste"
                        android:text="@string/poker_players_4"
                        android:textColor="@color/silver"
                        android:textSize="17sp" />
                </RadioGroup>

                <!-- ===== gli importi =====
                     OGNI COMANDO SOTTO LA SUA DESCRIZIONE, non di fianco: l'etichetta e il
                     valore erano sulla stessa riga e la riga era piena - etichetta, meno,
                     numero, piu' - quindi su uno schermo stretto l'etichetta si stringeva
                     fino a spezzarsi. Sopra e sotto c'e' posto per tutti due, e si legge
                     nell'ordine in cui si capisce: prima cosa e', poi quanto vale.
                     Il RESET sta accanto al titolo perche' vale per tutti tre gli importi:
                     accanto a uno solo sembrerebbe suo. -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:baselineAligned="false"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/poker_money"
                        android:textColor="@color/silver"
                        android:textSize="16sp" />

                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/btnImportiReset"
                        style="@style/PokerButton"
                        android:layout_width="wrap_content"
                        android:minWidth="96dp"
                        android:text="@string/poker_money_reset" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/poker_start_label"
                    android:textColor="@color/silver"
                    android:textSize="16sp" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:baselineAligned="false"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/btnFichesMeno"
                        style="@style/PokerButton"
                        android:layout_width="52dp"
                        android:contentDescription="@string/cd_less"
                        android:text="\u2212" />

                    <TextView
                        android:id="@+id/txtFiches"
                        android:layout_width="86dp"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:textColor="@color/silver"
                        android:textSize="17sp" />

                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/btnFichesPiu"
                        style="@style/PokerButton"
                        android:layout_width="52dp"
                        android:contentDescription="@string/cd_more"
                        android:text="+" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/poker_ante_label"
                    android:textColor="@color/silver"
                    android:textSize="16sp" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:baselineAligned="false"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/btnAperturaMeno"
                        style="@style/PokerButton"
                        android:layout_width="52dp"
                        android:contentDescription="@string/cd_less"
                        android:text="\u2212" />

                    <TextView
                        android:id="@+id/txtApertura"
                        android:layout_width="86dp"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:textColor="@color/silver"
                        android:textSize="17sp" />

                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/btnAperturaPiu"
                        style="@style/PokerButton"
                        android:layout_width="52dp"
                        android:contentDescription="@string/cd_more"
                        android:text="+" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/poker_raise_label"
                    android:textColor="@color/silver"
                    android:textSize="16sp" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:baselineAligned="false"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/btnRilancioMeno"
                        style="@style/PokerButton"
                        android:layout_width="52dp"
                        android:contentDescription="@string/cd_less"
                        android:text="\u2212" />

                    <TextView
                        android:id="@+id/txtRilancio"
                        android:layout_width="86dp"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:textColor="@color/silver"
                        android:textSize="17sp" />

                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/btnRilancioPiu"
                        style="@style/PokerButton"
                        android:layout_width="52dp"
                        android:contentDescription="@string/cd_more"
                        android:text="+" />
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="@string/poker_money_desc"
                    android:textColor="@color/silver"
                    android:textSize="13sp" />

                <!-- ===== le combinazioni facili: mazzo dal 6 all'asso ===== -->
                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/switchMazzoCorto"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:text="@string/poker_short_deck"
                    android:textColor="@color/silver"
                    android:textSize="17sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/poker_short_deck_desc"
                    android:textColor="@color/silver"
                    android:textSize="13sp" />

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/switchOdds"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:text="@string/show_odds"
                    android:textColor="@color/silver"
                    android:textSize="17sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/show_odds_desc"
                    android:textColor="@color/silver"
                    android:textSize="13sp" />


            </LinearLayout>

            <!-- Gioco responsabile -->
            <LinearLayout
                android:id="@+id/panelPausa"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:background="@drawable/panel_bg"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/pause_section"
                    android:textColor="@color/silver"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/switchPause"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/pause_switch"
                    android:textColor="@color/silver"
                    android:textSize="17sp"
                    app:thumbTint="@color/celeste"
                    app:trackTint="@color/steel" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/pause_switch_desc"
                    android:textColor="@color/silver_dark"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/txtPauseInfo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:textColor="@color/gold"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:visibility="gone" />
            </LinearLayout>

            <!-- Test -->
            <LinearLayout
                android:id="@+id/panelTest"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:background="@drawable/panel_bg"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/test_section"
                    android:textColor="@color/silver"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/switchAuto"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/auto_play"
                    android:textColor="@color/silver"
                    android:textSize="17sp"
                    app:thumbTint="@color/celeste"
                    app:trackTint="@color/steel" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/auto_play_desc"
                    android:textColor="@color/silver_dark"
                    android:textSize="14sp" />

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/switchBotCards"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="@string/show_bot_cards"
                    android:textColor="@color/silver"
                    android:textSize="17sp"
                    app:thumbTint="@color/celeste"
                    app:trackTint="@color/steel" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/show_bot_cards_desc"
                    android:textColor="@color/silver_dark"
                    android:textSize="14sp" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btnBack"
        android:layout_width="220dp"
        android:layout_height="52dp"
        android:layout_marginBottom="24dp"
        android:background="@drawable/btn_cartiglio"
