<?xml version="1.0" encoding="utf-8"?>
<!--
  Riepilogo di fine mano. Prima era testo incolonnato con gli spazi e carattere a larghezza
  fissa: 27 caratteri che sui telefoni stretti andavano a capo. Qui le colonne le tiene una
  TableLayout, quindi si torna al carattere normale e non c'e' piu' niente da far tornare
  a mano.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingEnd="24dp"
    android:paddingTop="10dp"
    android:paddingBottom="6dp">

    <TableLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:stretchColumns="0">

        <TableRow>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="56dp"
                android:gravity="end"
                android:paddingStart="10dp"
                android:paddingEnd="0dp"
                android:text="@string/you"
                android:textColor="@color/celeste"
                android:textSize="15sp"
                android:textStyle="bold" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="56dp"
                android:gravity="end"
                android:paddingStart="10dp"
                android:paddingEnd="0dp"
                android:text="@string/bot"
                android:textColor="@color/celeste"
                android:textSize="15sp"
                android:textStyle="bold" />
        </TableRow>

        <View
            android:layout_height="1dp"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="4dp"
            android:background="@color/silver_dark" />

        <TableRow>
            <TextView style="@style/ScoreLabel" android:text="@string/pt_carte" />
            <TextView android:id="@+id/youCarte" style="@style/ScoreValue" />
            <TextView android:id="@+id/botCarte" style="@style/ScoreValue" />
        </TableRow>
        <TableRow>
            <TextView style="@style/ScoreLabel" android:text="@string/pt_denari" />
            <TextView android:id="@+id/youDenari" style="@style/ScoreValue" />
            <TextView android:id="@+id/botDenari" style="@style/ScoreValue" />
        </TableRow>
        <TableRow>
            <TextView style="@style/ScoreLabel" android:text="@string/pt_settebello" />
            <TextView android:id="@+id/youSette" style="@style/ScoreValue" />
            <TextView android:id="@+id/botSette" style="@style/ScoreValue" />
        </TableRow>
        <TableRow>
            <TextView style="@style/ScoreLabel" android:text="@string/pt_primiera" />
            <TextView android:id="@+id/youPrimiera" style="@style/ScoreValue" />
            <TextView android:id="@+id/botPrimiera" style="@style/ScoreValue" />
        </TableRow>
        <TableRow>
            <TextView style="@style/ScoreLabel" android:text="@string/pt_scope" />
            <TextView android:id="@+id/youScope" style="@style/ScoreValue" />
            <TextView android:id="@+id/botScope" style="@style/ScoreValue" />
        </TableRow>

        <View
            android:layout_height="1dp"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="4dp"
            android:background="@color/silver_dark" />

        <!--
          Totale e Incontro non hanno un colore fisso: lo mette il codice, perche' dipende da
          chi e' avanti. Giallo se sei avanti tu, celeste se e' avanti il Banco, argento in
          parita'. Le due righe rispondono a due conti diversi: il Totale guarda questa
          partita, l'Incontro la serie, quindi possono benissimo essere di colori opposti.
        -->
        <TableRow>
            <TextView android:id="@+id/lblTot" style="@style/ScoreLabel"
                android:text="@string/pt_totale" android:textStyle="bold" />
            <TextView android:id="@+id/youTot" style="@style/ScoreValue"
                android:textStyle="bold" />
            <TextView android:id="@+id/botTot" style="@style/ScoreValue"
                android:textStyle="bold" />
        </TableRow>

        <!--
          L'incontro entra nella stessa tabella invece di stare su una riga a parte scritta
          a parole: i due numeri cadono sotto quelli del totale, nelle stesse colonne.
        -->
        <TableRow>
            <TextView android:id="@+id/lblMatch" style="@style/ScoreLabel"
                android:text="@string/pt_incontro" android:textStyle="bold" />
            <TextView android:id="@+id/youMatch" style="@style/ScoreValue"
                android:textStyle="bold" />
            <TextView android:id="@+id/botMatch" style="@style/ScoreValue"
                android:textStyle="bold" />
        </TableRow>
    </TableLayout>

    <TextView
        android:id="@+id/txtWinner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:textColor="@color/gold"
        android:textSize="16sp"
        android:textStyle="bold"
        android:visibility="gone" />
</LinearLayout>
