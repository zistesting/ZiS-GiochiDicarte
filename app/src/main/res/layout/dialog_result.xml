<?xml version="1.0" encoding="utf-8"?>
<!--
  Riepilogo di fine mano per Briscola e Tresette. E' la stessa struttura di dialog_score.xml
  (che la Scopa usa con in piu' la tabella dei quattro punti): esito della mano, riga della
  partita, e la riga del vincitore che compare solo quando la partita e' finita. Prima questi
  due giochi mettevano tutto nel messaggio dell'AlertDialog, quindi non si potevano colorare
  le singole righe e la disposizione non somigliava a quella della Scopa.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingEnd="24dp"
    android:paddingTop="10dp"
    android:paddingBottom="6dp">

    <TextView
        android:id="@+id/txtHand"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/celeste"
        android:textSize="17sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/txtMatch"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:textColor="@color/celeste"
        android:textSize="15sp" />

    <TextView
        android:id="@+id/txtWinner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:textColor="@color/celeste"
        android:textSize="16sp"
        android:textStyle="bold"
        android:visibility="gone" />
</LinearLayout>
