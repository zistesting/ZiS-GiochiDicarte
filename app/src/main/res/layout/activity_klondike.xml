<?xml version="1.0" encoding="utf-8"?>
<!--
  Il tavolo del Klondike.

  Le carte NON stanno nel layout: c'e' un contenitore solo, "board", e dentro le posiziona il
  codice. Qui le carte si sovrappongono a ventaglio con scarti diversi fra coperte e scoperte,
  e quello scarto va compresso quando la colonna si allunga: un LinearLayout non sa farlo.

  PERCHE' LA SCRITTA STA SU UNA RIGA SUA. Prima divideva la riga con i pulsanti: su un
  telefono stretto i pulsanti si prendevano quasi tutta la larghezza, alla scritta ne
  restava una ventina di punti e andava a capo UNA LETTERA PER RIGA. La barra diventava alta
  mezzo schermo, e siccome il tavolo prende l'altezza che avanza, le colonne restavano senza
  spazio e si schiacciavano fino a mostrare una carta sola. Un difetto di larghezza che si
  manifestava come un difetto di tutt'altro.

  Da qui due regole in questo file: la scritta sta da sola con maxLines a 1, e i pulsanti
  stanno in fondo, dove hanno tutta la riga per loro.
-->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_velvet">

    <ImageButton
        android:id="@+id/btnInfo"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_marginStart="4dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/cd_info"
        android:padding="9dp"
        android:scaleType="fitCenter"
        android:src="@drawable/btn_info"
        app:layout_constraintBottom_toBottomOf="@id/txtStatus"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/txtStatus" />

    <!--
      Agganciata ai due bordi dello schermo e non al pulsante info, cosi' resta al centro
      vero. Il padding laterale le impedisce di finire sotto al pulsante nelle lingue lunghe.
    -->
    <TextView
        android:id="@+id/txtStatus"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="4dp"
        android:ellipsize="end"
        android:gravity="center"
        android:maxLines="1"
        android:paddingStart="52dp"
        android:paddingEnd="52dp"
        android:textColor="@color/silver"
        android:textSize="15sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <FrameLayout
        android:id="@+id/board"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@id/bottomBar"
        app:layout_constraintTop_toBottomOf="@id/txtStatus" />

    <!--
      Il completamento automatico compare solo quando la partita e' ormai vinta. E'
      sovrapposto al tavolo e non incolonnato con gli altri due: dargli uno spazio fisso
      vorrebbe dire togliere altezza alle colonne per tutta la partita, per un pulsante che
      si vede negli ultimi dieci secondi.
    -->
    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btnFinish"
        android:layout_width="wrap_content"
        android:layout_height="48dp"
        android:layout_marginBottom="14dp"
        android:background="@drawable/btn_cartiglio"
        android:paddingStart="26dp"
        android:paddingEnd="26dp"
        android:text="@string/kl_finish"
        android:textAllCaps="false"
        android:textColor="@color/gold"
        android:textSize="16sp"
        android:textStyle="bold"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@id/bottomBar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <LinearLayout
        android:id="@+id/bottomBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingTop="6dp"
        android:paddingBottom="8dp"
        app:layout_constraintBottom_toBottomOf="parent">

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnUndo"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:background="@drawable/btn_cartiglio"
            android:text="@string/kl_undo"
            android:textAllCaps="false"
            android:textColor="@color/silver"
            android:textSize="15sp"
            android:textStyle="bold" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnDeal"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginStart="6dp"
            android:layout_marginEnd="12dp"
            android:layout_weight="1"
            android:background="@drawable/btn_cartiglio"
            android:text="@string/kl_deal"
            android:textAllCaps="false"
            android:textColor="@color/silver"
            android:textSize="15sp"
            android:textStyle="bold" />
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
