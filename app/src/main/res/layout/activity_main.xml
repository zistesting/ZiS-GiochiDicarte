<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_velvet">

    <ImageView
        android:id="@+id/logo"
        android:layout_width="92dp"
        android:layout_height="92dp"
        android:layout_marginTop="40dp"
        android:contentDescription="@string/app_name"
        android:src="@drawable/app_logo"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageView
        android:id="@+id/title"
        android:layout_width="330dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:adjustViewBounds="true"
        android:contentDescription="@string/title"
        android:src="@drawable/title_logo"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/logo" />

    <TextView
        android:id="@+id/version"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="v.3.9"
        android:textColor="@color/silver"
        android:textSize="16sp"
        android:textStyle="bold"
        android:shadowColor="#000000"
        android:shadowDy="2"
        android:shadowRadius="6"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/title" />

    <!--
      I QUATTRO GIOCHI SU DUE COLONNE, e sotto Esci.

      Prima erano cinque pulsanti in fila: 5 x 56dp piu' quattro spazi da 12dp fanno 328dp
      di altezza, che su un telefono da 640dp, con logo, titolo e riga in fondo, non lasciava
      respiro a niente. Su due colonne diventano 192dp: 136dp in meno.

      Le misure stanno in dimen.xml e non qui, perche' le usano sei pulsanti: cambiarne una
      in un posto solo evita che la griglia si sfasi. La larghezza e' tale che due colonne
      piu' lo spazio in mezzo entrino anche in uno schermo da 320dp.

      Esci e' centrato e larga come gli altri: e' l'unico della sua riga, e lasciarlo
      accostato a una delle due colonne sotto una griglia simmetrica sembra un errore.
    -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        app:layout_constraintBottom_toTopOf="@id/bottomBar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/version"
        app:layout_constraintVertical_bias="0.46">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnScopa"
                android:layout_width="@dimen/home_btn_w"
                android:layout_height="@dimen/home_btn_h"
                android:background="@drawable/btn_cartiglio"
                android:text="@string/play_scopa"
                android:textColor="@color/silver"
                android:textSize="17sp"
                android:textAllCaps="false"
                android:textStyle="bold"
                android:shadowColor="#000000"
                android:shadowDy="2"
                android:shadowRadius="4" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnBriscola"
                android:layout_width="@dimen/home_btn_w"
                android:layout_height="@dimen/home_btn_h"
                android:layout_marginStart="@dimen/home_btn_gap"
                android:background="@drawable/btn_cartiglio"
                android:text="@string/play_briscola"
                android:textColor="@color/silver"
                android:textSize="17sp"
                android:textAllCaps="false"
                android:textStyle="bold"
                android:shadowColor="#000000"
                android:shadowDy="2"
                android:shadowRadius="4" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/home_btn_gap"
            android:orientation="horizontal">

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnTresette"
                android:layout_width="@dimen/home_btn_w"
                android:layout_height="@dimen/home_btn_h"
                android:background="@drawable/btn_cartiglio"
                android:text="@string/play_tresette"
                android:textColor="@color/silver"
                android:textSize="17sp"
                android:textAllCaps="false"
                android:textStyle="bold"
                android:shadowColor="#000000"
                android:shadowDy="2"
                android:shadowRadius="4" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnKlondike"
                android:layout_width="@dimen/home_btn_w"
                android:layout_height="@dimen/home_btn_h"
                android:layout_marginStart="@dimen/home_btn_gap"
                android:background="@drawable/btn_cartiglio"
                android:text="@string/play_klondike"
                android:textColor="@color/silver"
                android:textSize="17sp"
                android:textAllCaps="false"
                android:textStyle="bold"
                android:shadowColor="#000000"
                android:shadowDy="2"
                android:shadowRadius="4" />
        </LinearLayout>

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnQuit"
            android:layout_width="@dimen/home_btn_w"
            android:layout_height="@dimen/home_btn_h"
            android:layout_marginTop="@dimen/home_btn_gap"
            android:background="@drawable/btn_cartiglio"
            android:text="@string/quit"
            android:textColor="@color/silver"
            android:textSize="16sp"
            android:textAllCaps="false"
            android:textStyle="bold"
            android:shadowColor="#000000"
            android:shadowDy="2"
            android:shadowRadius="4" />
    </LinearLayout>

    <!-- Riga in fondo: info, statistiche, impostazioni, logo ZiS. Quattro pulsanti da
         60dp non ci stavano in larghezza su un telefono da 360dp, quindi sono scesi a 52dp
         con margini piu' stretti: 304dp in tutto, che ci stanno ovunque. Sono in un LinearLayout invece che
         ancorati ai due bordi opposti, cosi' l'ordine e' quello scritto qui e restano
         distanziati allo stesso modo su qualunque larghezza di schermo. -->
    <LinearLayout
        android:id="@+id/bottomBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="18dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <ImageButton
            android:id="@+id/btnInfo"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp"
            android:background="@android:color/transparent"
            android:contentDescription="@string/cd_info"
            android:scaleType="fitCenter"
            android:src="@drawable/btn_info" />

        <ImageButton
            android:id="@+id/btnStats"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp"
            android:background="@android:color/transparent"
            android:contentDescription="@string/cd_stats"
            android:scaleType="fitCenter"
            android:src="@drawable/btn_stats" />

        <ImageButton
            android:id="@+id/btnSettings"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp"
            android:background="@android:color/transparent"
            android:contentDescription="@string/cd_settings"
            android:scaleType="fitCenter"
            android:src="@drawable/btn_settings" />

        <ImageButton
            android:id="@+id/btnZis"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp"
            android:background="@android:color/transparent"
            android:contentDescription="@string/cd_web"
            android:scaleType="fitCenter"
            android:src="@drawable/zis_logo" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
