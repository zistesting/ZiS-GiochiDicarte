<?xml version="1.0" encoding="utf-8"?>
<!--
  Statistiche di gioco. Colonne tenute da una TableLayout come nel riepilogo di fine mano
  della Scopa: stessi stili ScoreLabel e ScoreValue, stessa riga di separazione.

  Qui pero' le righe sono i giochi e le colonne le tre misure, non il contrario: i nomi dei
  giochi sono parole lunghe e stanno meglio nella colonna larga di sinistra, lasciando alle
  tre colonne strette i soli numeri.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingTop="10dp"
    android:paddingBottom="6dp">

    <!--
      LA PRIMA COLONNA NON SI STRINGE. Prima c'era shrinkColumns="0", cioe' proprio la
      colonna dei nomi: quando la tabella non ci stava in larghezza - e non ci stava,
      perche' le tre colonne dei numeri sono larghe quanto le loro intestazioni - a cedere
      erano i nomi dei giochi, che finivano tagliati a mezza parola. "Briscola" diventava
      "Brisc", "Tresette" "Trese", "Klondike" "Klond", e nessuno se ne accorgeva dal codice
      perche' il taglio lo fa la TableLayout in silenzio.

      Adesso a stringersi sono le colonne 1, 2 e 3, che contengono numeri di una o due
      cifre e hanno un minWidth: hanno margine da cedere, i nomi no.
    -->
    <TableLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:stretchColumns="0"
        android:shrinkColumns="1,2,3">

        <TableRow>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
            <TextView
                style="@style/StatsHeader"
                android:text="@string/stat_played"
                android:textColor="@color/celeste" />
            <TextView
                style="@style/StatsHeader"
                android:text="@string/stat_won"
                android:textColor="@color/celeste" />
            <TextView
                style="@style/StatsHeader"
                android:text="@string/stat_lost"
                android:textColor="@color/celeste" />
        </TableRow>

        <View
            android:layout_height="1dp"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="4dp"
            android:background="@color/silver_dark" />

        <TableRow>
            <TextView style="@style/ScoreLabel" android:maxLines="1" android:ellipsize="end" android:text="@string/play_scopa" />
            <TextView android:id="@+id/scopaPlayed" style="@style/StatsValue" />
            <TextView android:id="@+id/scopaYou" style="@style/StatsValue" android:textColor="@color/gold" />
            <TextView android:id="@+id/scopaBot" style="@style/StatsValue" />
        </TableRow>
        <TableRow>
            <TextView style="@style/ScoreLabel" android:maxLines="1" android:ellipsize="end" android:text="@string/play_briscola" />
            <TextView android:id="@+id/briscPlayed" style="@style/StatsValue" />
            <TextView android:id="@+id/briscYou" style="@style/StatsValue" android:textColor="@color/gold" />
            <TextView android:id="@+id/briscBot" style="@style/StatsValue" />
        </TableRow>
        <TableRow>
            <TextView style="@style/ScoreLabel" android:maxLines="1" android:ellipsize="end" android:text="@string/play_tresette" />
            <TextView android:id="@+id/trePlayed" style="@style/StatsValue" />
            <TextView android:id="@+id/treYou" style="@style/StatsValue" android:textColor="@color/gold" />
            <TextView android:id="@+id/treBot" style="@style/StatsValue" />
        </TableRow>

        <TableRow>
            <TextView style="@style/ScoreLabel" android:maxLines="1" android:ellipsize="end" android:text="@string/play_klondike" />
            <TextView android:id="@+id/klonPlayed" style="@style/StatsValue" />
            <TextView android:id="@+id/klonYou" style="@style/StatsValue" android:textColor="@color/gold" />
            <TextView android:id="@+id/klonBot" style="@style/StatsValue" />
        </TableRow>

        <View
            android:layout_height="1dp"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="4dp"
            android:background="@color/silver_dark" />

        <TableRow>
            <TextView style="@style/ScoreLabel" android:maxLines="1" android:ellipsize="end" android:text="@string/stat_total" android:textStyle="bold" />
            <TextView android:id="@+id/totPlayed" style="@style/StatsValue" android:textStyle="bold" />
            <TextView android:id="@+id/totYou" style="@style/StatsValue" android:textColor="@color/gold" android:textStyle="bold" />
            <TextView android:id="@+id/totBot" style="@style/StatsValue" android:textStyle="bold" />
        </TableRow>
    </TableLayout>

    <TextView
        android:id="@+id/statsNote"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:textColor="@color/silver_dark"
        android:textSize="13sp" />
</LinearLayout>
