<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_velvet">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="8dp"
        android:paddingEnd="8dp">

        <!-- Mano del Banco: dieci carte coperte, sovrapposte a ventaglio (i margini negativi
             li mette il codice, perche' dipendono dalla larghezza dello schermo) -->
        <FrameLayout
            android:id="@+id/botHandBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:id="@+id/botHand"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:orientation="horizontal" />
        </FrameLayout>

        <TextView
            android:id="@+id/txtMatch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center"
            android:textColor="@color/silver"
            android:textSize="15sp"
            android:textStyle="bold"
            android:shadowColor="#000000" android:shadowDy="2" android:shadowRadius="4" />

        <TextView
            android:id="@+id/botScore"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center"
            android:textColor="@color/silver"
            android:textSize="15sp"
            android:textStyle="bold"
            android:shadowColor="#000000" android:shadowDy="2" android:shadowRadius="4" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <!-- Riga centrale: il tallone ancorato a sinistra, le due carte della presa
                 centrate sullo schermo e non sullo spazio che avanza -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <FrameLayout
                    android:id="@+id/deckBox"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="start|center_vertical" />

                <LinearLayout
                    android:id="@+id/trickRow"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:gravity="center"
                    android:orientation="horizontal" />
            </FrameLayout>

            <TextView
                android:id="@+id/txtStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:textColor="@color/silver"
                android:textSize="15sp"
                android:textStyle="bold"
                android:shadowColor="#000000" android:shadowDy="2" android:shadowRadius="4" />

        </LinearLayout>

        <FrameLayout
            android:id="@+id/youHandBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <!-- Contenitore verticale: le file di carte le crea il codice, perche' quante
                 sono dipende da quante carte restano in mano -->
            <LinearLayout
                android:id="@+id/youHand"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:orientation="vertical" />
        </FrameLayout>

        <TextView
            android:id="@+id/youScore"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="8dp"
            android:gravity="center"
            android:textColor="@color/silver"
            android:textSize="15sp"
            android:textStyle="bold"
            android:shadowColor="#000000" android:shadowDy="2" android:shadowRadius="4" />
    </LinearLayout>

    <FrameLayout
        android:id="@+id/overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clickable="false"
        android:focusable="false"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
