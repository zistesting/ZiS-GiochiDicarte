<?xml version="1.0" encoding="utf-8"?>
<!-- Cornice "cartiglio": frame argento sfumato + interno navy.
     Sostituisce il vecchio nine-patch: scala correttamente a qualsiasi dimensione. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- frame argento -->
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="270"
                android:startColor="#EDF1F6"
                android:centerColor="#AEB9C6"
                android:endColor="#76828F" />
            <corners android:radius="14dp" />
        </shape>
    </item>
    <!-- battuta scura tra frame e interno -->
    <item android:left="3dp" android:top="3dp" android:right="3dp" android:bottom="3dp">
        <shape android:shape="rectangle">
            <solid android:color="#0A1018" />
            <corners android:radius="12dp" />
        </shape>
    </item>
    <!-- interno navy sfumato -->
    <item android:left="4dp" android:top="4dp" android:right="4dp" android:bottom="4dp">
        <shape android:shape="rectangle">
            <gradient android:angle="270"
                android:startColor="#1C3559"
                android:endColor="#0D1B33" />
            <corners android:radius="11dp" />
        </shape>
    </item>
    <!-- La spaziatura interna del testo, che stava attaccata al filetto d'oro.
         IL FILO D'ORO NON C'E' PIU': era una riga in piu' da guardare dentro una cornice che
         di righe ne ha gia' tre - argento, battuta scura, navy - e su un pulsante il risalto
         lo da' la cornice, non un filetto. Ma il <padding> di quella voce serviva: e' quello
         che tiene il testo lontano dai bordi, quindi la voce resta, trasparente e senza
         bordo. Togliendola tutta, le scritte finirebbero appiccicate alla cornice. -->
    <item android:left="7dp" android:top="7dp" android:right="7dp" android:bottom="7dp">
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
            <corners android:radius="8dp" />
            <padding android:left="12dp" android:top="4dp" android:right="12dp" android:bottom="4dp" />
        </shape>
    </item>
</layer-list>
