<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.Scopa" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/navy_mid</item>
        <item name="colorPrimaryVariant">@color/navy_deep</item>
        <item name="colorOnPrimary">@color/celeste_light</item>
        <item name="colorSecondary">@color/gold</item>
        <item name="android:statusBarColor" tools:targetApi="l">@color/navy_deep</item>
        <item name="alertDialogTheme">@style/DarkAlertDialog</item>
        <item name="materialAlertDialogTheme">@style/DarkAlertDialog</item>
    </style>

    <style name="DarkAlertDialog" parent="Theme.MaterialComponents.Dialog.Alert">
        <item name="colorSurface">@color/navy</item>
        <item name="android:colorBackground">@color/navy</item>
        <item name="colorOnSurface">@color/silver</item>
        <item name="android:textColorPrimary">@color/silver</item>
        <item name="android:textColorSecondary">@color/silver</item>
        <item name="colorPrimary">@color/silver</item>
    </style>
    <!-- righe del riepilogo di fine mano (dialog_score.xml) -->
    <style name="ScoreLabel">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:paddingTop">3dp</item>
        <item name="android:paddingBottom">3dp</item>
        <item name="android:textColor">@color/silver</item>
        <item name="android:textSize">15sp</item>
    </style>

    <!-- Come ScoreValue ma piu' stretto: la tabella delle statistiche ha quattro colonne
         invece di tre, e con 56dp l'ultima finiva oltre il bordo della finestra. -->
    <!--
      Intestazione della tabella delle statistiche: come StatsValue ma piu' piccola.

      Non e' un vezzo. La larghezza di una colonna la decide la sua cella piu' larga, e
      nelle tre colonne dei numeri quella cella e' l'INTESTAZIONE - "Giocati" e' molto piu'
      larga di un numero a due cifre. Rimpicciolire l'intestazione stringe le tre colonne
      dei numeri, e tutto lo spazio che si libera va alla prima colonna, che e' quella con
      i nomi dei giochi.
    -->
    <style name="StatsHeader" parent="StatsValue">
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="StatsValue">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minWidth">36dp</item>
        <item name="android:paddingStart">6dp</item>
        <item name="android:paddingTop">3dp</item>
        <item name="android:paddingBottom">3dp</item>
        <item name="android:gravity">end</item>
        <item name="android:textColor">@color/silver</item>
        <item name="android:textSize">15sp</item>
    </style>

    <style name="ScoreValue">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minWidth">56dp</item>
        <item name="android:paddingStart">10dp</item>
        <item name="android:paddingTop">3dp</item>
        <item name="android:paddingBottom">3dp</item>
        <item name="android:gravity">end</item>
        <item name="android:textColor">@color/silver</item>
        <item name="android:textSize">15sp</item>
    </style>
</resources>
